<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  User LaunchAgent for the appliance Mac. Install to
  ~/Library/LaunchAgents/com.magicmirror.launchagent.plist and load with
  `launchctl bootstrap gui/$(id -u) <path>`.

  This is the SINGLE restart owner. `KeepAlive = {SuccessfulExit = false}` means
  launchd relaunches the app after any non-zero exit but respects a clean quit
  (exit 0) — which is exactly the contract the in-app crash policy relies on:
  a crashed renderer is recreated once in-process, and when that budget is spent
  the app exits 1 so launchd restarts the whole app. The app never calls
  `app.relaunch()`; two restart owners fight.

  A login item would start the app but gives no supervision, so it is not used.

  ThrottleInterval bounds a restart loop: combined with the one in-app recreate,
  a hard-failing build restarts at most every 10 seconds instead of spinning.

  PLACEHOLDERS: replace __USER__ with the appliance account's short name (launchd
  does NOT expand `~`) and confirm the .app path after Phase 7 packaging.

  STATUS: authored on the Windows dev machine — NOT field-verified. Verify on the
  target Mac in Phase 7 (login, crash, and clean-quit behaviour).
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.magicmirror.launchagent</string>

    <key>ProgramArguments</key>
    <array>
      <string>/Applications/Magic Mirror.app/Contents/MacOS/Magic Mirror</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
      <key>SuccessfulExit</key>
      <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>/Users/__USER__/Library/Logs/MagicMirror/launchagent.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/__USER__/Library/Logs/MagicMirror/launchagent.err.log</string>
  </dict>
</plist>
