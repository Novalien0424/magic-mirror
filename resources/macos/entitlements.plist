<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the signed Magic Mirror .app (Phase 7).

  device.audio-input / device.camera pair with the Info.plist usage descriptions;
  without both halves the grant never reaches the spawned wake and face workers.

  The four `cs.*` entitlements are what Electron/Chromium needs to run under the
  hardened runtime: V8 JIT, and loading the Python face worker's unsigned runtime
  libraries (onnxruntime, OpenCV) from a child process.

  App Sandbox is deliberately NOT enabled: the app spawns non-bundled helper
  processes and reads config/DB outside a container.

  STATUS: authored on the Windows dev machine — NOT field-verified. Verify on the
  target Mac in Phase 7 (codesign with the entitlements flag, notarization, first launch).
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <key>com.apple.security.device.camera</key>
    <true/>

    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
