# Dependencies / build output (Phase 0+)
node_modules/
dist/
!src/vendor/live2d/Framework/dist/
!src/vendor/live2d/Framework/dist/**
out/
build/
*.tsbuildinfo
resources/generated/

# Local environment & secrets — Electron Main alone loads the ignored root .env
.env
.env.*
*.local.json
.claude/settings.local.json

# Runtime data (SQLite, enrollment images, diagnostics, backups live outside the repo,
# but guard against accidental copies)
*.sqlite
*.sqlite-wal
*.sqlite-shm
data/
diagnostics/
backups/

# Large binary assets are delivered out-of-band until an asset pipeline exists
assets/avatar/
assets/music/
assets/offline/

# SDD orchestration scratch (ledger/briefs/reports live on disk, not in git)
.superpowers/
.worktrees/
.artifacts/
resources/wake-models/*/*
!resources/wake-models/*/manifest.json
wake-corpus/

# OS noise
.DS_Store
Thumbs.db
