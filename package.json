{
  "name": "magic-mirror",
  "version": "0.1.0",
  "private": true,
  "description": "Magic Mirror — Electron kiosk appliance (Phase 0 foundation)",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "generate:offline-loop": "node scripts/generate-offline-loop.mjs",
    "prepare:avatar": "node scripts/prepare-avatar-assets.mjs",
    "generate:avatar-audio": "node scripts/generate-avatar-audio.mjs",
    "predev": "npm run generate:offline-loop && npm run prepare:avatar && npm run generate:avatar-audio",
    "prebuild": "npm run generate:offline-loop && npm run prepare:avatar && npm run generate:avatar-audio",
    "package": "electron-builder --dir --publish never",
    "smoke": "electron .",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:phase1:live": "node scripts/run-phase1-live-smoke.mjs",
    "test:phase4:qa": "node scripts/run-phase4-qa.mjs",
    "test:phase4:qa:console": "node scripts/run-phase4-qa.mjs --console",
    "test:phase4:qa:editor": "node scripts/run-phase4-qa.mjs --editor",
    "test:phase4:qa:manual": "node scripts/run-phase4-qa.mjs --manual",
    "test:phase4:qa:live": "node scripts/run-phase4-qa.mjs --live",
    "test:phase4:qa:lifecycle-live": "node scripts/run-phase4-qa.mjs --lifecycle-live",
    "evaluate:wake": "node scripts/evaluate-wake-models.mjs"
  },
  "dependencies": {
    "@openai/agents": "0.16.1",
    "@openai/agents-realtime": "0.16.1",
    "decibri": "5.7.0",
    "sherpa-onnx-node": "1.13.6",
    "write-file-atomic": "^8.0.0",
    "xstate": "^5.32.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
